NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional locally; set to the canonical HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SERPER_API_KEY=
OPENAI_API_KEY=
SENTRY_DSN=
# Required only in deployment CI for source-map uploads.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
NEXT_PUBLIC_POSTHOG_KEY=
# Optional; defaults to the US ingest endpoint.
NEXT_PUBLIC_POSTHOG_HOST=
CRON_SECRET=
# Optional; otherwise the server derives a limiter HMAC key from CRON_SECRET.
RATE_LIMIT_SECRET=
ADMIN_EMAILS=
