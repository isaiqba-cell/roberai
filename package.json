{
  "name": "rober",
  "private": true,
  "version": "0.1.0",
  "description": "Rober investor-demo MVP monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @rober/mobile run dev",
    "ios": "npm --workspace @rober/mobile run ios",
    "android": "npm --workspace @rober/mobile run android",
    "web": "npm --workspace @rober/mobile run web",
    "web:dev": "npm --workspace @rober/web run dev",
    "web:build": "npm --workspace @rober/web run build",
    "audit:high": "node scripts/security/audit-web-production.mjs",
    "security:boundaries": "node scripts/security/check-web-secret-boundaries.mjs",
    "export:web": "npm --workspace @rober/mobile run export:web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck:workspaces && npm run typecheck:scripts",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "typecheck:scripts": "tsc --project scripts/tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "maestro test apps/mobile/maestro/onboarding-to-checkout.yaml",
    "test:auth:live": "tsx scripts/supabase/verify-auth-browser.ts",
    "test:auth:providers": "tsx scripts/supabase/verify-auth-providers.ts",
    "test:rls": "tsx scripts/supabase/verify-rls.ts",
    "test:ingestion:live": "tsx scripts/supabase/verify-ingestion.ts",
    "test:ingestion:corpus": "tsx scripts/supabase/verify-live-corpus.ts",
    "test:ingestion:garments": "tsx scripts/supabase/verify-live-garment-corpus.ts",
    "test:matching:live": "tsx scripts/supabase/verify-live-matching.ts",
    "audit:ingestion:sources": "tsx scripts/ingestion/audit-live-sources.ts",
    "ingest:corpus:enqueue": "tsx scripts/ingestion/enqueue-live-chart-corpus.ts",
    "ingest:garments:enqueue": "tsx scripts/ingestion/enqueue-live-garment-corpus.ts",
    "test:stage2:live": "npm run test:auth:providers && npm run test:rls && npm run test:auth:live",
    "seed": "tsx scripts/seed/generate-demo-catalog.ts",
    "seed:jeans": "tsx scripts/seed/generate-jeans-size-chart-database.ts",
    "seed:web": "tsx scripts/seed/seed-supabase-web.ts",
    "seed:web:dry": "tsx scripts/seed/seed-supabase-web.ts --dry-run",
    "seed:try-ons": "tsx scripts/seed/pregenerate-try-ons.ts",
    "supabase:migrate": "npx supabase db push --linked --include-all --yes"
  },
  "devDependencies": {
    "@expo/cli": "^57.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.0",
    "eslint": "9.39.4",
    "jest": "30.4.2",
    "prettier": "3.9.4",
    "ts-jest": "29.4.11",
    "tsx": "4.23.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
